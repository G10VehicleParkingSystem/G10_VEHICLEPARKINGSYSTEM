PORT=5000
# Signs login tokens. Use a long random value; if empty, a random one is made at
# start-up and everyone is signed out when the server restarts.
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Parking office (admin) account, created on start-up if it does not exist yet.
ADMIN_EMAIL=office@campuspark.test
ADMIN_PASSWORD=change-this-password
MONGO_URI=mongodb://127.0.0.1:27017/g10_vehicle_parking
PAYMENT_GATEWAY=demo
HOURLY_PARKING_RATE=50
FINE_PER_HOUR=100
OVERSTAY_CHECK_INTERVAL_MS=60000
UPCOMING_REMINDER_MINUTES=30
EXPIRY_REMINDER_MINUTES=15
