{
  "name": "g10-parking-backend",
  "version": "1.0.0",
  "description": "Backend for the G10 Vehicle Parking System (FR-1 to FR-7)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
    "demo": "node scripts/sprint1-demo.mjs",
    "test:coverage": "c8 --all --include \"src/**\" --include server.js --reporter=text --reporter=html node --test tests/*.test.js",
    "test:blackbox": "node tests/blackbox/run-blackbox.mjs",
    "reports": "node scripts/generate-test-reports.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
